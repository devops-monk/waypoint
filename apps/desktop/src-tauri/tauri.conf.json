{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waypoint",
  "version": "0.1.2",
  "identifier": "app.waypoint.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Waypoint",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Honest, private job search copilot",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwQUQ0NEY5NDM5QUZFMDMKUldRRC9wcEQrVVN0Y0g3SFA4YzR0Rmo5OWhjM2FFYy9WY1M4dlNJa0VvbHBVNHJTVC9WT254Q3QK",
      "endpoints": [
        "https://waypoint.devops-monk.com/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
